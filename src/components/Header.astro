---
import logo from '../assets/img/logo-bm.png';

const navLinks = [
  { name: 'Inicio', href: '#inicio' },
  { name: 'Paquetes', href: '#paquetes' },
  { name: 'Shows', href: '#shows' },
  { name: 'Catering', href: '#catering' },
  { name: 'Cotización', href: '#cotizacion' },
  // { name: 'CRM / Ingresar', href: '#crm' },
];
---

<header class="sticky top-0 z-50 backdrop-blur-md bg-cream-100/90 border-b border-wood-700/10">
  <div class="max-w-[1200px] mx-auto px-4 py-3 flex flex-col md:flex-row items-start md:items-center justify-between gap-4 md:gap-0">
    
    <!-- Brand -->
    <a href="#inicio" class="flex items-center gap-3 group" aria-label="Bosque Mágico Inicio">
      <img 
        src={logo.src} 
        alt="Logo Bosque Mágico" 
        class="w-[62px] h-[62px] object-contain bg-[#fff4de] rounded-xl p-1.5 border border-[#e6d2aa] group-hover:scale-105 transition-transform" 
      />
      <div class="flex flex-col">
        <strong class="font-fredoka text-forest-900 text-[1.6rem] leading-none">Bosque Mágico</strong>
        <span class="text-wood-700 text-sm font-bold">Zona infantil de Refugio</span>
      </div>
    </a>

    <!-- Navigation -->
    <nav class="flex flex-wrap gap-1 items-center" aria-label="Principal">
      {navLinks.map(link => (
        <a 
          href={link.href} 
          class="text-forest-900 px-3 py-2 rounded-full text-base font-fredoka hover:bg-olive-500/20 focus-visible:bg-olive-500/20 transition-colors"
        >
          {link.name}
        </a>
      ))}
    </nav>

    <!-- Actions -->
    <div class="flex items-center gap-2.5 w-full md:w-auto">
      <a 
        href="#cotizacion" 
        class="inline-flex items-center justify-center text-forest-900 bg-[#edf6de] border border-[#cfe3af] px-5 py-2.5 rounded-full font-fredoka font-bold text-base hover:-translate-y-0.5 transition-transform whitespace-nowrap"
      >
        Cotizar ahora
      </a>
      <a 
        href="#crm" 
        class="inline-flex items-center justify-center text-white bg-gradient-to-b from-forest-700 to-forest-900 shadow-[0_12px_28px_rgba(31,59,42,0.27)] px-5 py-2.5 rounded-full font-fredoka font-bold text-base hover:-translate-y-0.5 transition-transform whitespace-nowrap"
      >
        Ingresar
      </a>
    </div>

  </div>
</header>
