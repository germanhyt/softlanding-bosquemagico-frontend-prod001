---
---

<section id="cotizacion" class="py-16">
  <div class="max-w-[1200px] mx-auto px-4">
    
    <div class="flex flex-col gap-3 mb-8">
      <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-[#c9dbaf] bg-[#eef6df] text-forest-800 font-bold text-sm w-fit font-fredoka">
        <span class="w-2 h-2 rounded-full bg-olive-600"></span>
        Formulario de cotización
      </span>
      <h2 class="text-[clamp(2rem,3.5vw,3.1rem)] text-forest-900 leading-tight">
        Solicita tu propuesta personalizada
      </h2>
      <p class="text-ink-700 text-lg">Formulario comercial pensado para conversación de venta y pre-reserva.</p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-[1.1fr_0.9fr] gap-6 p-6 rounded-[30px] border-2 border-[#dfcea8] bg-gradient-to-b from-[#fffef9] to-[#f3f8e8] shadow-soft">
      
      <!-- Form -->
      <form id="quoteForm" class="grid grid-cols-1 sm:grid-cols-2 gap-4" novalidate>
        <div class="flex flex-col gap-1.5">
          <label for="clienteNombre" class="text-forest-900 font-fredoka">Nombre del cliente</label>
          <input id="clienteNombre" name="clienteNombre" required class="w-full border border-[#ddccaa] rounded-xl px-3.5 py-2.5 bg-[#fffef9] text-ink-900 focus:outline-none focus:ring-2 focus:ring-[#d7e8b8]" />
        </div>
        <div class="flex flex-col gap-1.5">
          <label for="celular" class="text-forest-900 font-fredoka">Celular</label>
          <input id="celular" name="celular" type="tel" required class="w-full border border-[#ddccaa] rounded-xl px-3.5 py-2.5 bg-[#fffef9] text-ink-900 focus:outline-none focus:ring-2 focus:ring-[#d7e8b8]" />
        </div>
        <div class="flex flex-col gap-1.5">
          <label for="correo" class="text-forest-900 font-fredoka">Correo</label>
          <input id="correo" name="correo" type="email" required class="w-full border border-[#ddccaa] rounded-xl px-3.5 py-2.5 bg-[#fffef9] text-ink-900 focus:outline-none focus:ring-2 focus:ring-[#d7e8b8]" />
        </div>
        <div class="flex flex-col gap-1.5">
          <label for="cumpleanero" class="text-forest-900 font-fredoka">Nombre del cumpleañero</label>
          <input id="cumpleanero" name="cumpleanero" required class="w-full border border-[#ddccaa] rounded-xl px-3.5 py-2.5 bg-[#fffef9] text-ink-900 focus:outline-none focus:ring-2 focus:ring-[#d7e8b8]" />
        </div>
        <div class="flex flex-col gap-1.5">
          <label for="edad" class="text-forest-900 font-fredoka">Edad</label>
          <input id="edad" name="edad" type="number" min="1" max="15" required class="w-full border border-[#ddccaa] rounded-xl px-3.5 py-2.5 bg-[#fffef9] text-ink-900 focus:outline-none focus:ring-2 focus:ring-[#d7e8b8]" />
        </div>
        <div class="flex flex-col gap-1.5">
          <label for="fechaEvento" class="text-forest-900 font-fredoka">Fecha del evento</label>
          <input id="fechaEvento" name="fechaEvento" type="date" required class="w-full border border-[#ddccaa] rounded-xl px-3.5 py-2.5 bg-[#fffef9] text-ink-900 focus:outline-none focus:ring-2 focus:ring-[#d7e8b8]" />
        </div>
        <div class="flex flex-col gap-1.5">
          <label for="turno" class="text-forest-900 font-fredoka">Turno</label>
          <select id="turno" name="turno" required class="w-full border border-[#ddccaa] rounded-xl px-3.5 py-2.5 bg-[#fffef9] text-ink-900 focus:outline-none focus:ring-2 focus:ring-[#d7e8b8]">
            <option value="">Selecciona</option>
            <option>Turno 1 - 9:00 a.m. - 12:00 m.</option>
            <option>Turno 2 - 2:00 p.m. - 5:00 p.m.</option>
            <option>Turno 3 - 7:00 p.m. - 10:00 p.m.</option>
          </select>
        </div>
        <div class="flex flex-col gap-1.5">
          <label for="ninos" class="text-forest-900 font-fredoka">Cantidad de niños</label>
          <input id="ninos" name="ninos" type="number" min="10" max="35" required class="w-full border border-[#ddccaa] rounded-xl px-3.5 py-2.5 bg-[#fffef9] text-ink-900 focus:outline-none focus:ring-2 focus:ring-[#d7e8b8]" />
        </div>
        <div class="flex flex-col gap-1.5">
          <label for="tematica" class="text-forest-900 font-fredoka">Temática</label>
          <input id="tematica" name="tematica" class="w-full border border-[#ddccaa] rounded-xl px-3.5 py-2.5 bg-[#fffef9] text-ink-900 focus:outline-none focus:ring-2 focus:ring-[#d7e8b8]" />
        </div>
        <div class="flex flex-col gap-1.5">
          <label for="paquete" class="text-forest-900 font-fredoka">Paquete</label>
          <select id="paquete" name="paquete" class="w-full border border-[#ddccaa] rounded-xl px-3.5 py-2.5 bg-[#fffef9] text-ink-900 focus:outline-none focus:ring-2 focus:ring-[#d7e8b8]">
            <option>Básico</option>
            <option>Estándar</option>
            <option>Premium</option>
          </select>
        </div>
        <div class="flex flex-col gap-1.5 sm:col-span-2">
          <label for="extras" class="text-forest-900 font-fredoka">Extras</label>
          <input id="extras" name="extras" placeholder="Ejemplo: pintacaritas + asistente" class="w-full border border-[#ddccaa] rounded-xl px-3.5 py-2.5 bg-[#fffef9] text-ink-900 focus:outline-none focus:ring-2 focus:ring-[#d7e8b8]" />
        </div>
        <div class="flex flex-col gap-1.5 sm:col-span-2">
          <label for="observaciones" class="text-forest-900 font-fredoka">Observaciones</label>
          <textarea id="observaciones" name="observaciones" class="w-full min-h-[100px] border border-[#ddccaa] rounded-xl px-3.5 py-2.5 bg-[#fffef9] text-ink-900 focus:outline-none focus:ring-2 focus:ring-[#d7e8b8] resize-y"></textarea>
        </div>
        <div class="sm:col-span-2 pt-2">
          <button type="submit" class="w-full sm:w-auto inline-flex items-center justify-center text-white bg-gradient-to-b from-forest-700 to-forest-900 shadow-strong px-8 py-3.5 rounded-full font-fredoka font-bold text-lg hover:-translate-y-0.5 transition-transform">
            Calcular estimado
          </button>
        </div>
      </form>

      <!-- Result Aside -->
      <aside class="p-6 rounded-2xl border border-[#dceabf] bg-gradient-to-b from-[#f8ffea] to-[#edf6d9] flex flex-col gap-4 self-start sticky top-24" aria-live="polite">
        <div class="flex flex-col gap-1">
          <h3 class="text-3xl text-forest-900 font-fredoka">Resumen de cotización</h3>
          <p class="text-sm text-ink-700" id="quoteSummary">Completa los datos para calcular la tarifa base.</p>
        </div>
        
        <div class="flex flex-col gap-2 w-full mt-2">
          <div class="flex justify-between items-center border-b border-dashed border-[#cfddb2] pb-2">
            <span class="text-ink-900">Tarifa base</span>
            <strong class="text-forest-900 font-fredoka text-lg" id="quoteBase">S/ 0.00</strong>
          </div>
          <div class="flex justify-between items-center border-b border-dashed border-[#cfddb2] pb-2">
            <span class="text-ink-900">Adicional niños (26-35)</span>
            <strong class="text-forest-900 font-fredoka text-lg" id="quoteExtraKids">S/ 0.00</strong>
          </div>
          <div class="flex justify-between items-center pt-1">
            <span class="text-ink-900 font-bold">Total estimado</span>
            <strong class="text-forest-900 font-fredoka text-2xl" id="quoteTotal">S/ 0.00</strong>
          </div>
        </div>
        
        <p class="text-xs text-ink-700 mt-2 bg-white/40 p-3 rounded-lg border border-[#cfddb2]/50">
          Reserva con adelanto de S/ 500. Este cálculo es referencial y se confirma al cerrar contrato. (Simulación local interactiva).
        </p>
      </aside>

    </div>
  </div>
</section>

<script>
  // Simple Mock Logic to make the UI feel alive before the API is connected.
  const form = document.getElementById('quoteForm') as HTMLFormElement;
  const fechaInput = document.getElementById('fechaEvento') as HTMLInputElement;
  const ninosInput = document.getElementById('ninos') as HTMLInputElement;
  const paqueteSelect = document.getElementById('paquete') as HTMLSelectElement;
  
  const quoteBase = document.getElementById('quoteBase');
  const quoteExtraKids = document.getElementById('quoteExtraKids');
  const quoteTotal = document.getElementById('quoteTotal');

  function calculateQuote() {
    if(!fechaInput.value) return;

    let base = 380;
    const dateObj = new Date(fechaInput.value);
    // 0 = Monday (in standard UTC depending on timezone parsing), let's simplify for the mock
    // Just a dummy check: if it's weekend, bump price
    const day = dateObj.getUTCDay(); 
    const isWeekend = (day === 5 || day === 6); // 5=Sat, 6=Sun in zero-indexed

    const paquete = paqueteSelect.value;
    
    if (paquete === "Básico") base = isWeekend ? 580 : 380;
    else if (paquete === "Estándar") base = isWeekend ? 680 : 480;
    else if (paquete === "Premium") base = isWeekend ? 780 : 580;

    let kids = parseInt(ninosInput.value || "0", 10);
    let extraKidsCost = 0;
    if (kids > 25) {
      const extraCount = Math.min(kids - 25, 10); // max 35 cap logic
      extraKidsCost = extraCount * 25;
    }

    const total = base + extraKidsCost;

    if (quoteBase) quoteBase.textContent = `S/ ${base.toFixed(2)}`;
    if (quoteExtraKids) quoteExtraKids.textContent = `S/ ${extraKidsCost.toFixed(2)}`;
    if (quoteTotal) quoteTotal.textContent = `S/ ${total.toFixed(2)}`;
  }

  // Bind events
  form?.addEventListener('input', calculateQuote);
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    calculateQuote();
    alert("¡Cotización simulada calculada! Próximamente se conectará a la API.");
  });
</script>