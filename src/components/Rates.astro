<section id="tarifas" class="py-10">
  <div class="max-w-[1200px] mx-auto px-4 grid grid-cols-1 md:grid-cols-2 gap-5">
    
    <article class="bg-white/90 border border-cream-200 rounded-[20px] shadow-soft p-6 md:p-8 hover:shadow-strong transition-shadow">
      <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-[#c9dbaf] bg-[#eef6df] text-forest-800 font-bold text-sm w-fit font-fredoka mb-5">
        <span class="w-2 h-2 rounded-full bg-olive-600"></span>
        Capacidad, horarios y tarifas base
      </span>
      <ul class="flex flex-col gap-3">
        <li class="bg-cream-100 border border-cream-200 rounded-xl p-3.5 text-ink-900">
          <strong class="text-wood-700 font-fredoka">Capacidad base:</strong> 10 a 25 niños
        </li>
        <li class="bg-cream-100 border border-cream-200 rounded-xl p-3.5 text-ink-900">
          <strong class="text-wood-700 font-fredoka">Niños del 26 al 35:</strong> + S/ 25 por niño
        </li>
        <li class="bg-cream-100 border border-cream-200 rounded-xl p-3.5 text-ink-900">
          <strong class="text-wood-700 font-fredoka">Turno 1:</strong> 9:00 a.m. - 12:00 m.
        </li>
        <li class="bg-cream-100 border border-cream-200 rounded-xl p-3.5 text-ink-900">
          <strong class="text-wood-700 font-fredoka">Turno 2:</strong> 2:00 p.m. - 5:00 p.m.
        </li>
        <li class="bg-cream-100 border border-cream-200 rounded-xl p-3.5 text-ink-900">
          <strong class="text-wood-700 font-fredoka">Turno 3:</strong> 7:00 p.m. - 10:00 p.m.
        </li>
        <li class="bg-cream-100 border border-cream-200 rounded-xl p-3.5 text-ink-900">
          <strong class="text-wood-700 font-fredoka">Lunes a viernes:</strong> S/ 380
        </li>
        <li class="bg-cream-100 border border-cream-200 rounded-xl p-3.5 text-ink-900">
          <strong class="text-wood-700 font-fredoka">Sábados y domingos:</strong> S/ 580
        </li>
      </ul>
    </article>

    <article class="bg-white/90 border border-cream-200 rounded-[20px] shadow-soft p-6 md:p-8 hover:shadow-strong transition-shadow">
      <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-[#c9dbaf] bg-[#eef6df] text-forest-800 font-bold text-sm w-fit font-fredoka mb-5">
        <span class="w-2 h-2 rounded-full bg-olive-600"></span>
        Experiencia Bosque Mágico
      </span>
      <ul class="flex flex-col gap-3">
        <li class="bg-cream-100 border border-cream-200 rounded-xl p-3.5 text-ink-900">
          <strong class="text-wood-700 font-fredoka">Formato:</strong> Evento privado por turno con atención planificada.
        </li>
        <li class="bg-cream-100 border border-cream-200 rounded-xl p-3.5 text-ink-900">
          <strong class="text-wood-700 font-fredoka">Ambientación:</strong> Estilo natural, madera cálida y detalles infantiles premium.
        </li>
        <li class="bg-cream-100 border border-cream-200 rounded-xl p-3.5 text-ink-900">
          <strong class="text-wood-700 font-fredoka">Complementos:</strong> Shows, servicios extras y catering en un mismo flujo comercial.
        </li>
        <li class="bg-cream-100 border border-cream-200 rounded-xl p-3.5 text-ink-900">
          <strong class="text-wood-700 font-fredoka">Operación:</strong> CRM interno para leads, contratos, pagos y postventa.
        </li>
      </ul>
    </article>

  </div>
