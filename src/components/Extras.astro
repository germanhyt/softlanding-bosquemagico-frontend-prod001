---
const extrasData = [
  { nombre: "Pintacaritas", detalle: "Diseños infantiles con materiales hipoalergénicos." },
  { nombre: "Uñitas", detalle: "Mini estación de esmaltado infantil." },
  { nombre: "Hora loca", detalle: "Activación musical y accesorios temáticos." },
  { nombre: "Asistente de fiestas", detalle: "Apoyo operativo durante todo el evento." },
  { nombre: "Adicional por niño", detalle: "+ S/ 25 por niño (del 26 al 35) para shows y operación extendida." }
];
---

<section id="servicios-extras" class="py-10">
  <div class="max-w-[1200px] mx-auto px-4">
    
    <div class="flex flex-col gap-3 mb-8">
      <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-[#c9dbaf] bg-[#eef6df] text-forest-800 font-bold text-sm w-fit font-fredoka">
        <span class="w-2 h-2 rounded-full bg-olive-600"></span>
        Servicios extras
      </span>
      <h2 class="text-[clamp(2rem,3.5vw,3.1rem)] text-forest-900 leading-tight">
        Complementos para elevar la experiencia
      </h2>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {extrasData.map((extra) => (
        <article class="bg-white border border-cream-200 rounded-[20px] p-5 shadow-soft hover:-translate-y-1 transition-transform duration-300">
          <h3 class="text-forest-900 text-xl font-fredoka mb-2">{extra.nombre}</h3>
          <p class="text-ink-700 text-sm leading-relaxed">{extra.detalle}</p>
        </article>
      ))}
    </div>

  </div>
</section>