---
import '../styles/global.css';

interface Props {
	title: string;
	description?: string;
}

const { title, description = "Tu fiesta infantil soñada en un bosque cálido, elegante y privado." } = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		
		<!-- Google Fonts: Fredoka & Nunito -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800;900&family=Fredoka:wght@400;500;600;700&display=swap" rel="stylesheet" />
		
		<title>{title} | Bosque Mágico</title>
	</head>
	<body class="antialiased selection:bg-olive-500 selection:text-white">
		<slot />
	</body>
</html>